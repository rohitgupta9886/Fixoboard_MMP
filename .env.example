# FixoBoard MMS - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.

# Application
ENVIRONMENT=development
PROJECT_NAME="FixoBoard MMS"
API_V1_STR=/api/v1
PORT=8000
DEBUG=True

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Local SQLite Development:
DATABASE_URL=sqlite+aiosqlite:///./fixoboard.db

# PostgreSQL Production (Docker):
# DATABASE_URL=postgresql+asyncpg://fixo_admin:fixo_secure_password_2026@localhost:5432/fixoboard_mms
# POSTGRES_USER=fixo_admin
# POSTGRES_PASSWORD=fixo_secure_password_2026
# POSTGRES_DB=fixoboard_mms

# Local File Storage
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Google Gemini / Vision AI Configuration (Optional for OCR & Advisor)
AI_PO_EXTRACTOR_ENABLED=True
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://localhost:5173"]
