# =================================================================
# FixoBoard MMS - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual environment settings.
# NEVER commit real secret credentials to version control.

# -----------------------------------------------------------------
# 1. BACKEND WEB SERVICE CONFIGURATION
# -----------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="FixoBoard MMS"
API_V1_STR=/api/v1
PORT=8000

# Security & JWT Authentication (REQUIRED in production: min 16 chars)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection URL
# Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./fixoboard.db

# Production (Render PostgreSQL / Docker Compose):
# Render supplies: postgres://... or postgresql://...
# The application automatically converts it to asyncpg: postgresql+asyncpg://...
# Example:
# DATABASE_URL=postgresql+asyncpg://fixo_admin:fixo_secure_password_2026@postgres:5432/fixoboard_mms

# Local Upload Directory
LOCAL_UPLOAD_DIR=uploads
STORAGE_BACKEND=local

# CORS Allowed Origins (Comma-separated or JSON array)
# In production Render, enter your Frontend Render Web Service URL:
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,https://fixoboard-frontend.onrender.com

# -----------------------------------------------------------------
# 2. AI MULTIMODAL VISION & OCR (OPTIONAL)
# -----------------------------------------------------------------
AI_PO_EXTRACTOR_ENABLED=True
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------
# 3. FRONTEND WEB SERVICE CONFIGURATION (Vite)
# -----------------------------------------------------------------
# For Local Dev (Vite proxy handles /api): leave empty or use http://localhost:8000
# For Render Deployment: set to your Backend Render Web Service URL
VITE_API_URL=https://fixoboard-backend.onrender.com
